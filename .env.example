# Copy this file to `.env` for local development. Do NOT commit `.env`.
#
# --- App ---
DEBUG=true
APP_TITLE="Vue FastAPI Admin"
APP_DESCRIPTION="Vue FastAPI Admin API"

# --- Security / JWT ---
# Generate: `python -c "import secrets; print(secrets.token_hex(32))"`
SECRET_KEY="change-me"
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Database (MySQL) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=vue_fastapi_admin
DB_CONNECTION_NAME=mysql

# Optional: a full DSN string. If set, it overrides the DB_* fields.
# Examples:
#   mysql://root:password@127.0.0.1:3306/vue_fastapi_admin
#   mysql://root:password@127.0.0.1:3306/vue_fastapi_admin?charset=utf8mb4
DB_DSN=

#开发环境配置跨域,注意生产环境请修改为具体域名，或者为空，不然存在安全隐患
#CORS_ORIGINS='["https://admin.example.com","https://www.example.com"]' #指定域名
CORS_ORIGINS=*
